{
	"name": "pi-extensions",
	"version": "0.1.0",
	"private": true,
	"description": "Custom pi coding agent extensions: SSH remote execution + Brave web search",
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"typecheck:watch": "tsc --noEmit --watch",
		"lint": "biome check",
		"format": "biome check --write",
		"prepare": "simple-git-hooks"
	},
	"lint-staged": {
		"*.ts": "biome check --write"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged && npm run typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@earendil-works/pi-coding-agent": "^1.0.0",
		"@earendil-works/pi-tui": "^1.0.0",
		"@types/node": "^24.0.0",
		"lint-staged": "^17.6.0",
		"simple-git-hooks": "^2.14.0",
		"typescript": "^5.9.0"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^1.0.0",
		"typebox": "^1.3.34"
	}
}
