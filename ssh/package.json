{
	"name": "@sdillen/pi-ssh",
	"version": "0.2.2",
	"description": "pi extension: run all tools on an SSH host, with sudo and YubiKey/ED25519-SK support via ControlMaster",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"ssh",
		"sudo",
		"remote",
		"yubikey"
	],
	"type": "module",
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "npm run build"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sdillen/pi-extensions.git",
		"directory": "ssh"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	}
}
